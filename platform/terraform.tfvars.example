project_name              = "fcaj-devsecops"
environment               = "dev"
aws_region                = "ap-southeast-1"
github_owner              = "YOUR_GITHUB_USER_OR_ORG"
github_repo               = "fcaj-aws-devsecops"
github_branch             = "main"
terraform_state_bucket    = "REPLACE_WITH_BOOTSTRAP_OUTPUT"
pipeline_artifact_bucket  = "REPLACE_WITH_BOOTSTRAP_OUTPUT"
notification_email        = "you@example.com"
budget_limit_usd          = 5
instance_type             = "t3.micro"
enable_cloudtrail         = true
